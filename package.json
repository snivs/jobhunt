{
  "name": "jobhunt",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Job Hunter - Claude Code orchestrated job discovery, scoring and application system with SQLite + obsidian-second-brain",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/server.ts",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "db:status": "tsx src/cli.ts db:status",
    "jobhunt": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
