# Autonomous Job Hunter - environment variables
# Copy to .env (never committed). Secrets live ONLY here or in a secret manager.

# Absolute path to the Obsidian vault (second brain). Also read by obsidian-second-brain.
OBSIDIAN_VAULT_PATH=C:/codebase/jobhunt/vault

# Path to the SQLite database file (default: ./data/jobhunt.db)
JOBHUNT_DB_PATH=./data/jobhunt.db

# Path to the YAML config (default: ./config/jobhunt.yaml)
JOBHUNT_CONFIG_PATH=./config/jobhunt.yaml

# Optional API keys for job sources that require them (leave empty to disable that source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
